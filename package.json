{
  "name": "markdown-alert",
  "displayName": "Markdown Alert",
  "description": "Provides support for GitHub Alert callouts in VS Code's live Markdown Preview, with support for automatic theme detection and Markdown stylesheet theme overrides.",
  "version": "1.0.0",
  "publisher": "tbruneel",
  "license": "MIT",
  "homepage": "https://github.com/tbruneel/vscode-markdown-alert#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/tbruneel/vscode-markdown-alert.git"
  },
  "bugs": {
    "url": "https://github.com/tbruneel/vscode-markdown-alert/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./styles/markdown-alert.css"
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --format=cjs --platform=node --external:vscode",
    "check": "tsc --noEmit",
    "watch": "npm run build -- --watch"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.5.2",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.2"
  }
}
